generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  phone            String?
  company          String?
  leadSource       String
  courseInterest   String?
  serviceInterest  String?
  qualifyingAnswer String?
  message          String?
  photoUrl         String?
  leadScore        Int      @default(0)
  status           String   @default("new")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  notes            Note[]
  student          Student?

  @@map("leads")
  @@index([status])
  @@index([leadSource])
  @@index([createdAt])
}

model Student {
  id            String    @id @default(cuid())
  leadId        String    @unique
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name          String
  email         String    @unique
  phone         String?
  courseName    String
  cohort        String?
  startDate     DateTime?
  paymentStatus String    @default("pending")
  amountPaid    Int       @default(0)
  notes         String?
  enrolledAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("students")
  @@index([paymentStatus])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content   String
  type      String   @default("note")
  createdBy String?
  createdAt DateTime @default(now())

  @@map("notes")
}

model Webinar {
  id                           String                @id @default(cuid())
  slug                         String                @unique
  title                        String
  subtitle                     String?
  date                         DateTime
  time                         String
  description                  String?
  formatSummary                String?
  speakers                     Json                  @default("[]")
  registrationOpen             Boolean               @default(true)
  qualifyingQuestion           String                @default("What's pulling you toward cybersecurity or AI?")
  thumbnailImage               String?
  recordingUrl                 String?
  recordingPermissionConfirmed Boolean               @default(false)
  recapContent                 String?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  registrations                WebinarRegistration[]

  @@map("webinars")
  @@index([date])
}

model WebinarRegistration {
  id               String   @id @default(cuid())
  webinarId        String
  webinar          Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  name             String
  email            String
  phone            String?
  qualifyingAnswer String?
  createdAt        DateTime @default(now())

  @@unique([webinarId, email])
  @@map("webinar_registrations")
  @@index([webinarId])
}

model AdminUser {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  name         String
  role         String               @default("marketer")
  createdAt    DateTime             @default(now())
  resetTokens  PasswordResetToken[]

  @@map("admin_users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  number      String   @default("01")
  title       String
  description String
  cta         String   @default("Talk to us")
  icon        String   @default("shield")
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  website   String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partners")
}

model Course {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  coverImage            String?
  title                 String
  academy               String   @default("cybersecurity")
  tier                  Int
  path                  String?
  level                 String
  duration              String
  format                String   @default("Online, cohort-based")
  startingPrice         Int      @default(0)
  isStartHere           Boolean  @default(false)
  isMostPopular         Boolean  @default(false)
  featured              Boolean  @default(false)
  published             Boolean  @default(true)
  description           String?
  prerequisites         Json     @default("[]")
  whatYouLearn          Json     @default("[]")
  capstone              String?
  advancedElective      String?
  certificationAlignment Json    @default("[]")
  careerPaths           Json     @default("[]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("courses")
}
